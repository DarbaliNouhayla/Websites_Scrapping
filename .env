# Database
DATABASE_URL=postgresql://postgres@localhost:5433/tprm_db

# Pipeline mode
USE_DB=true
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_STATIC=2.0
RATE_LIMIT_DYNAMIC=3.0
CONCURRENCY=3

# Scheduler
RSS_INTERVAL_MINUTES=30
HTML_STATIC_INTERVAL_MINUTES=60
HTML_DYNAMIC_INTERVAL_HOURS=6
TENDER_INTERVAL_HOURS=12

# NVD enrichment for CISA CVSS scores
USE_NVD_ENRICHMENT=true
NVD_API_KEY=

# Groq LLM (severity classification)
GROQ_API_KEY=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

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=20000
